# Pokémon Atlas 3D - Environment Configuration Template
# Copy this file to .env or .env.local to customize local variables.
# Note: Pokémon Atlas 3D connects directly to PokéAPI and public 3D asset CDNs.
# No secret API keys are required to run this application!

# Optional: Host port configuration for Vite dev server (default: 3000)
# PORT=3000

# Optional: Disable Hot Module Replacement (useful for sandboxed test environments)
# DISABLE_HMR=false

# Optional: Application canonical URL for self-referential Open Graph meta tags
# VITE_APP_URL="http://localhost:3000"
